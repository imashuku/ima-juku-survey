{
  "version": 2,
  "name": "ima-juku-survey",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "feedback.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/feedback",
      "dest": "/feedback.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
